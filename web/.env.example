# The rating data: the public data bucket (production) ...
DATA_URL=https://data.example.com
# ... or a local export folder (development), relative to web/
# DATA_DIR=../pipeline/export

# Sanity (club content); without it, content/clubs.json is used
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared with the pipeline workflow and the Sanity webhook: POST /api/revalidate
REVALIDATE_SECRET=

# The Studio's preview of the written pages (About, Help & support): a Viewer token from sanity.io/manage
# (API → Tokens), to read drafts in draft mode. Server only: never NEXT_PUBLIC_.
SANITY_READ_TOKEN=

# User accounts (Supabase: supabase/ in the repo, README "User accounts"): the project's URL and its public anon key.
# Without them the accounts are off: no sign-in, no /account or /ideas. For local development, `pnpm dlx supabase start`
# from the repo root prints both.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "1" once Google sign-in is set up in the Supabase project (Authentication → Sign In / Providers)
NEXT_PUBLIC_SUPABASE_GOOGLE=
# The data bucket's public address, read by the browser too (EloStonk's players file: free traffic from R2, not
# Vercel's); the bucket needs a CORS rule letting the site's pages read it (README: "EloStonk"). Leave it empty locally:
# the game then reads the local export through /api/elostonk/players.
NEXT_PUBLIC_DATA_URL=
# Cloudflare Turnstile's site key (public), the check on the sign-in form; its secret key goes into Supabase
# (Authentication → Attack Protection → CAPTCHA). Leave it empty against a local Supabase, which doesn't check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Push notifications (README: "Notifications"): the public half of the VAPID key pair; the private half is a secret of
# the push-draws function in Supabase. Without it the account page offers no notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
