# rclone filter of pipeline/data: the raw inputs kept in the raw bucket (see workflows/pipeline.yml).
# Everything else in data/ is rebuilt by rate.mjs, eliteserien.mjs, upcoming.mjs and export.mjs.
+ /portalen/**
+ /league/**
+ /ranking/**
+ /tournaments/**
+ /upcoming/raw/**
# The tournaments' draw analyses: a nightly run only redoes the upcoming ones (upcoming.mjs), so
# the played ones must be kept from earlier runs to stay in the list
+ /upcoming/*.json
# The fingerprints of the last rebuild (pipeline/fingerprint.mjs), to see what's new
+ /build-fingerprint.txt
# What the fetch scripts remember to avoid needless requests (league groups, tournament end dates)
+ /cache/**
+ /tournaments.json
+ /players.json
+ /clubs.json
+ /eliteserien-*.json
- *
